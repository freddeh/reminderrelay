<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Identity -->
    <key>Label</key>
    <string>com.github.njoerd114.reminderrelay</string>

    <!-- Launch the app bundle through LaunchServices (`open -a`), not the bare
         binary: macOS only grants "Local Network" and "Reminders" access to
         something it can identify as an app, and a binary exec'd directly by
         launchd gets "no route to host" for LAN addresses. -W keeps `open`
         running for as long as the app runs, so KeepAlive below still works.
         The stdout/stderr flags below route the app's own output to the log files. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-W</string>
        <string>-a</string>
        <string>{{xml .AppPath}}</string>
        <string>--stdout</string>
        <string>{{xml .HomeDir}}/Library/Logs/reminderrelay/output.log</string>
        <string>--stderr</string>
        <string>{{xml .HomeDir}}/Library/Logs/reminderrelay/errors.log</string>
        <string>--args</string>
        <string>daemon</string>
    </array>

    <!-- Lifecycle -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Logging: this only captures `open` itself (e.g. "unable to find
         application"); the app's own output is routed by the flags above. -->
    <key>StandardOutPath</key>
    <string>{{xml .HomeDir}}/Library/Logs/reminderrelay/output.log</string>
    <key>StandardErrorPath</key>
    <string>{{xml .HomeDir}}/Library/Logs/reminderrelay/errors.log</string>

    <!-- Throttle restarts if the daemon crashes immediately -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
